DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
GROQ_API_KEY=your_groq_api_key
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
PORT=8000

# ── Business data collection (business_scraper/) ──────────────────────────────
# Where scraped business records live. Defaults to <repo>/Data_Scraped, which is
# also where business_scraper writes, so both sides agree without configuration.
# SCRAPED_DATA_DIR=

# Python interpreter used to launch the scraper. Defaults to
# business_scraper/venv (which has Playwright installed), falling back to the
# system python. Set this only if your interpreter lives elsewhere.
# SCRAPER_PYTHON=
