# ── Unclaimed public-directory listings (kill switch, spec §D.3) ──────────────
# Imported Google Maps businesses are REAL, NAMED people who never consented to
# being listed and were never verified by 7 Kaam.
#
#   false -> every unclaimed listing is removed from GET /api/v1/public/workers
#            and GET /api/v1/public/workers/:id returns 404 for it, regardless
#            of any query parameter.
#   true  -> unclaimed listings are discoverable, always ranked BELOW every
#            verified/claimed worker and always labelled `isUnclaimed: true`.
#
# The code default when this variable is absent is `true`, so dev and staging
# exercise the real path. SHIP PRODUCTION WITH `false` until the DPDP Act 2023
# notice-at-first-contact and a working opt-out are signed off by product/legal
# (spec §J.1). Phone numbers of unclaimed listings are never returned to any
# caller, at any value of this flag.
SEVENKAAM_DIRECTORY_LISTINGS_PUBLIC=false
