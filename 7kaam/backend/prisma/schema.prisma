generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Trade {
  ELECTRICIAN
  PLUMBER
  CARPENTER
  AC_TECHNICIAN
  PAINTER
  WELDER
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  EXPERT
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AdminRole {
  SUPER_ADMIN
  CITY_ADMIN
  REVIEWER
}

enum TestLanguage {
  ENGLISH
  HINDI
  KANNADA
  TAMIL
}

enum SubmissionStatus {
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}

enum SignalType {
  VIDEO
  TEST
  WORK_HISTORY
  FINAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Worker {
  id               String       @id @default(uuid())
  aadhaarHash      String       @unique
  fullName         String
  phoneNumber      String       @unique
  profilePhotoUrl  String?
  trade            Trade
  city             String
  locality         String?
  videoUrl         String?
  videoScore       Float?
  videoScoredAt    DateTime?
  testScore        Float?
  testScoredAt     DateTime?
  workHistoryScore Float?
  finalScore       Float?
  tier             Tier?
  kaamCardUrl      String?
  qrCodeUrl        String?
  kaamCardIssuedAt DateTime?
  aadhaarVerified  Boolean      @default(false)
  status           WorkerStatus @default(PENDING)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  testSubmissions   TestSubmission[]
  videoAssessments  VideoAssessment[]
  workHistories     WorkHistory[]
  kaamCards         KaamCard[]
  scoringLogs       ScoringLog[]
  bookings          Booking[]
  skillCertificates SkillCertificate[]
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(REVIEWER)
  city         String?
  createdAt    DateTime  @default(now())

  createdTests TradeTest[]
}

model TradeTest {
  id                 String       @id @default(uuid())
  trade              Trade
  language           TestLanguage
  title              String
  description        String       @default("")
  category           String       @default("General")
  difficulty         Difficulty   @default(BEGINNER)
  estimatedMinutes   Int          @default(15)
  passingScore       Int          @default(60)
  totalAttempts      Int          @default(0)
  questions          Json
  isActive           Boolean      @default(true)
  isVideoAssessment  Boolean      @default(false)
  rubrics            Json?
  createdBy          String?
  prerequisiteTestId String?
  isFirstTest        Boolean      @default(false)
  createdAt          DateTime     @default(now())

  admin             Admin?             @relation(fields: [createdBy], references: [id])
  prerequisite      TradeTest?         @relation("TestPrerequisites", fields: [prerequisiteTestId], references: [id])
  dependentTests    TradeTest[]        @relation("TestPrerequisites")
  submissions       TestSubmission[]
  videoAssessments  VideoAssessment[]
  skillCertificates SkillCertificate[]
}

model TestSubmission {
  id            String           @id @default(uuid())
  workerId      String
  testId        String
  answers       Json
  rawScore      Float?
  aiEvaluation  Json?
  timeTakenSecs Int?
  attemptNumber Int              @default(1)
  status        SubmissionStatus @default(SUBMITTED)
  submittedAt   DateTime         @default(now())

  worker      Worker            @relation(fields: [workerId], references: [id])
  test        TradeTest         @relation(fields: [testId], references: [id])
  certificate SkillCertificate?
}

model SkillCertificate {
  id            String     @id @default(uuid())
  workerId      String
  testId        String
  submissionId  String?    @unique
  title         String
  trade         Trade
  category      String     @default("General")
  difficulty    Difficulty @default(BEGINNER)
  score         Float
  passingScore  Int        @default(60)
  issuedAt      DateTime   @default(now())
  pdfUrl        String?
  certificateNo String     @unique @default(uuid())

  worker     Worker          @relation(fields: [workerId], references: [id])
  test       TradeTest       @relation(fields: [testId], references: [id])
  submission TestSubmission? @relation(fields: [submissionId], references: [id])
}

model VideoAssessment {
  id            String    @id @default(uuid())
  workerId      String
  testId        String
  videoUrl      String
  score         Float?
  rubricScores  Json?
  feedback      String?
  status        String    @default("PENDING")
  attemptNumber Int       @default(1)
  submittedAt   DateTime  @default(now())
  scoredAt      DateTime?

  worker Worker    @relation(fields: [workerId], references: [id])
  test   TradeTest @relation(fields: [testId], references: [id])
}

model WorkHistory {
  id                 String    @id @default(uuid())
  workerId           String
  clientName         String
  clientType         String    @default("HOUSEHOLD")
  clientPhone        String?
  clientCity         String
  projectTitle       String
  projectDescription String
  trade              Trade
  startDate          DateTime
  endDate            DateTime?
  durationMonths     Int       @default(0)
  projectScale       String    @default("SMALL")
  photoUrls          String[]  @default([])
  isVerified         Boolean   @default(false)
  createdAt          DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id])
}

model KaamCard {
  id                 String            @id @default(uuid())
  workerId           String
  scoreBreakdown     Json
  qrToken            String            @unique
  pdfUrl             String?
  version            Int               @default(1)
  totalTestsTaken    Int               @default(0)
  totalVideosTaken   Int               @default(0)
  certificatesEarned Int               @default(0)
  credibilityLevel   String            @default("EMERGING")
  issuedAt           DateTime          @default(now())
  expiresAt          DateTime
  lastUpdatedAt      DateTime          @default(now()) @updatedAt
  isRevoked          Boolean           @default(false)
  revokedReason      String?

  worker    Worker            @relation(fields: [workerId], references: [id])
  histories KaamCardHistory[]
}

model KaamCardHistory {
  id               String   @id @default(uuid())
  kaamCardId       String
  version          Int
  finalScore       Float
  videoScore       Float
  testScore        Float
  workHistoryScore Float
  totalTests       Int      @default(0)
  totalVideos      Int      @default(0)
  recordedAt       DateTime @default(now())

  kaamCard KaamCard @relation(fields: [kaamCardId], references: [id], onDelete: Cascade)
}

model ScoringLog {
  id          String     @id @default(uuid())
  workerId    String
  signalType  SignalType
  inputData   Json?
  outputScore Float
  scoredAt    DateTime   @default(now())
  notes       String?

  worker Worker @relation(fields: [workerId], references: [id])
}

model Customer {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  fullName    String
  city        String
  createdAt   DateTime @default(now())

  bookings Booking[]
}

model Booking {
  id          String        @id @default(uuid())
  customerId  String
  workerId    String
  trade       Trade
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime
  address     String
  notes       String?
  createdAt   DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  worker   Worker   @relation(fields: [workerId], references: [id])
}
