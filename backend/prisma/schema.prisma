generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Trade {
  ELECTRICIAN
  PLUMBER
  CARPENTER
  AC_TECHNICIAN
  PAINTER
  WELDER
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  EXPERT
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum WorkerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AdminRole {
  SUPER_ADMIN
  CITY_ADMIN
  REVIEWER
}

enum TestLanguage {
  ENGLISH
  HINDI
  KANNADA
  TAMIL
}

enum SubmissionStatus {
  SUBMITTED
  EVALUATING
  COMPLETED
  FAILED
}

enum SignalType {
  VIDEO
  TEST
  WORK_HISTORY
  FINAL
}

// DEPRECATED: booking is not part of the current product surface (7 Kaam is a
// discovery/trust platform, not a booking middleman — see 7Kaam sync spec).
// Kept for historical data only; no routes read/write this model.
enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

model Worker {
  id               String       @id @default(uuid())
  // NULLABLE since migration 3: a public-directory listing has no Aadhaar on
  // file because the person never gave us one. No placeholder hash is ever
  // invented for them. Postgres permits unlimited NULLs in a UNIQUE index, so
  // @unique is unaffected. Self-signup rows must still carry a hash — that is
  // enforced by the DB constraint Worker_selfsignup_requires_aadhaarHash.
  aadhaarHash      String?      @unique
  fullName         String
  phoneNumber      String       @unique
  profilePhotoUrl  String?
  trade            Trade
  city             String
  locality         String?
  latitude         Float?
  longitude        Float?
  videoUrl         String?
  videoScore       Float?
  videoScoredAt    DateTime?
  testScore        Float?
  testScoredAt     DateTime?
  workHistoryScore Float?
  finalScore       Float?
  tier             Tier?
  kaamCardUrl      String?
  qrCodeUrl        String?
  kaamCardIssuedAt DateTime?
  aadhaarVerified  Boolean      @default(false)
  status           WorkerStatus @default(PENDING)
  // Set by admin "Require Recertification" action after a complaint; cleared
  // once the worker passes every test listed in recertificationTestIds.
  underReview             Boolean  @default(false)
  recertificationTestIds  String[] @default([])
  recertificationReason   String?

  // ── Provenance / claim state (migration 3) ────────────────────────────────
  // A row with listingSource = "PUBLIC_DIRECTORY" is a REAL, NAMED business
  // scraped from a public directory that never consented to being here and has
  // never been verified by 7 Kaam. Such a row MUST keep videoScore, testScore,
  // workHistoryScore, finalScore, tier, kaamCardUrl, qrCodeUrl and
  // kaamCardIssuedAt NULL and aadhaarVerified = false until it is CLAIMED.
  // That is enforced in the database by the CHECK constraint
  // Worker_unclaimed_has_no_trust_data — do not attempt to work around it.
  // No Google rating, review count or any derivative is stored: those columns
  // deliberately do not exist. A directory rating is NOT a 7 Kaam score.
  listingSource     String    @default("SELF_SIGNUP")
  claimStatus       String    @default("CLAIMED")
  sourceName        String?
  sourceRef         String?   @unique
  sourceUrl         String?
  sourceAddress     String?
  importBatchId     String?
  importedAt        DateTime?
  claimRequestedAt  DateTime?
  claimedAt         DateTime?
  suppressedAt      DateTime?
  suppressionReason String?
  tradeInferred     Boolean   @default(false)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  testSubmissions   TestSubmission[]
  videoAssessments  VideoAssessment[]
  workHistories     WorkHistory[]
  kaamCards         KaamCard[]
  scoringLogs       ScoringLog[]
  // DEPRECATED: see BookingStatus above.
  bookings          Booking[]
  skillCertificates SkillCertificate[]
  reports           Report[]
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(REVIEWER)
  city         String?
  createdAt    DateTime  @default(now())

  createdTests TradeTest[]
}

model TradeTest {
  id                 String       @id @default(uuid())
  trade              Trade
  language           TestLanguage
  title              String
  description        String       @default("")
  category           String       @default("General")
  difficulty         Difficulty   @default(BEGINNER)
  estimatedMinutes   Int          @default(15)
  passingScore       Int          @default(60)
  totalAttempts      Int          @default(0)
  questions          Json
  isActive           Boolean      @default(true)
  isVideoAssessment  Boolean      @default(false)
  rubrics            Json?
  createdBy          String?
  prerequisiteTestId String?
  isFirstTest        Boolean      @default(false)
  createdAt          DateTime     @default(now())

  admin             Admin?             @relation(fields: [createdBy], references: [id])
  prerequisite      TradeTest?         @relation("TestPrerequisites", fields: [prerequisiteTestId], references: [id])
  dependentTests    TradeTest[]        @relation("TestPrerequisites")
  submissions       TestSubmission[]
  videoAssessments  VideoAssessment[]
  skillCertificates SkillCertificate[]
}

model TestSubmission {
  id            String           @id @default(uuid())
  workerId      String
  testId        String
  answers       Json
  rawScore      Float?
  aiEvaluation  Json?
  timeTakenSecs Int?
  attemptNumber Int              @default(1)
  status        SubmissionStatus @default(SUBMITTED)
  submittedAt   DateTime         @default(now())

  worker      Worker            @relation(fields: [workerId], references: [id])
  test        TradeTest         @relation(fields: [testId], references: [id])
  certificate SkillCertificate?
}

model SkillCertificate {
  id            String     @id @default(uuid())
  workerId      String
  testId        String
  submissionId  String?    @unique
  title         String
  trade         Trade
  category      String     @default("General")
  difficulty    Difficulty @default(BEGINNER)
  score         Float
  passingScore  Int        @default(60)
  issuedAt      DateTime   @default(now())
  pdfUrl        String?
  certificateNo String     @unique @default(uuid())

  worker     Worker          @relation(fields: [workerId], references: [id])
  test       TradeTest       @relation(fields: [testId], references: [id])
  submission TestSubmission? @relation(fields: [submissionId], references: [id])
}

model VideoAssessment {
  id            String    @id @default(uuid())
  workerId      String
  testId        String
  videoUrl      String
  score         Float?
  rubricScores  Json?
  feedback      String?
  status        String    @default("PENDING")
  attemptNumber Int       @default(1)
  submittedAt   DateTime  @default(now())
  scoredAt      DateTime?

  worker Worker    @relation(fields: [workerId], references: [id])
  test   TradeTest @relation(fields: [testId], references: [id])
}

model WorkHistory {
  id                 String    @id @default(uuid())
  workerId           String
  clientName         String
  clientType         String    @default("HOUSEHOLD")
  clientPhone        String?
  clientCity         String
  projectTitle       String
  projectDescription String
  trade              Trade
  startDate          DateTime
  endDate            DateTime?
  durationMonths     Int       @default(0)
  projectScale       String    @default("SMALL")
  photoUrls          String[]  @default([])
  isVerified         Boolean   @default(false)
  createdAt          DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id])
}

model KaamCard {
  id                 String            @id @default(uuid())
  workerId           String
  scoreBreakdown     Json
  qrToken            String            @unique
  pdfUrl             String?
  version            Int               @default(1)
  totalTestsTaken    Int               @default(0)
  totalVideosTaken   Int               @default(0)
  certificatesEarned Int               @default(0)
  credibilityLevel   String            @default("EMERGING")
  issuedAt           DateTime          @default(now())
  expiresAt          DateTime
  lastUpdatedAt      DateTime          @default(now()) @updatedAt
  isRevoked          Boolean           @default(false)
  revokedReason      String?

  worker    Worker            @relation(fields: [workerId], references: [id])
  histories KaamCardHistory[]
}

model KaamCardHistory {
  id               String   @id @default(uuid())
  kaamCardId       String
  version          Int
  finalScore       Float
  videoScore       Float
  testScore        Float
  workHistoryScore Float
  totalTests       Int      @default(0)
  totalVideos      Int      @default(0)
  recordedAt       DateTime @default(now())

  kaamCard KaamCard @relation(fields: [kaamCardId], references: [id], onDelete: Cascade)
}

model ScoringLog {
  id          String     @id @default(uuid())
  workerId    String
  signalType  SignalType
  inputData   Json?
  outputScore Float
  scoredAt    DateTime   @default(now())
  notes       String?

  worker Worker @relation(fields: [workerId], references: [id])
}

model Customer {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  fullName    String
  city        String
  createdAt   DateTime @default(now())

  // DEPRECATED: see BookingStatus above.
  bookings Booking[]
  reports  Report[]
}

// DEPRECATED: booking is not part of the current product surface. Kept for
// historical data only — no routes read/write this model. Do not add new
// endpoints against it; see 7Kaam sync spec.
model Booking {
  id          String        @id @default(uuid())
  customerId  String
  workerId    String
  trade       Trade
  status      BookingStatus @default(PENDING)
  scheduledAt DateTime
  address     String
  notes       String?
  createdAt   DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  worker   Worker   @relation(fields: [workerId], references: [id])
}

// Customer complaint against a worker, reviewed by admins in the moderation
// queue. Dismissal/actioning are status transitions here; the actual
// enforcement (suspend/revoke/recertify) happens via the admin worker
// endpoints and is applied independently.
model Report {
  id                 String       @id @default(uuid())
  workerId           String
  reporterCustomerId String
  reason             String
  description        String?
  status             ReportStatus @default(OPEN)
  createdAt          DateTime     @default(now())

  worker           Worker   @relation(fields: [workerId], references: [id])
  reporterCustomer Customer @relation(fields: [reporterCustomerId], references: [id])
}
