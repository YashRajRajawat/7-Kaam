# ── Environment & Secrets ───────────────────────────────────────────────────
# Never commit real credentials. Only *.env.example belongs in git.
.env
.env.local
.env.*.local
.env.production.local
*.env
!*.env.example
!.env.example

# ── Node modules & Package Managers ──────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Build outputs & Frameworks ───────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
coverage/
.nyc_output/
.cache/

# ── IDEs and Editors ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace
.eslintcache
.stylelintcache

# ── Backend Specific ─────────────────────────────────────────────────────────
backend/node_modules/
backend/dist/
backend/.env.local
backend/uploads/
backend/temp/

# ── Dashboard Specific ───────────────────────────────────────────────────────
dashboard/.next/
dashboard/out/
dashboard/build/
dashboard/public/sw.js
dashboard/.env.local

# ── Mobile / Flutter Specific ────────────────────────────────────────────────
mobile/build/
mobile/.dart_tool/
mobile/pubspec.lock
mobile/ios/Pods/
mobile/android/app/debug/
mobile/android/app/release/
*/build/
*/.dart_tool/

# ── Python / Scraper / Trust Engine ──────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── Scraped Directory Data ───────────────────────────────────────────────────
# Keep raw scraped dataset out of git to avoid committing local business PII
Data_Scraped/*
!Data_Scraped/README.md
!Data_Scraped/.gitkeep

# ── Local Databases, Logs & Scratch ─────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.log
logs/
*.pid
*.seed
dump.rdb
debug_screenshot.png
*.tmp
*.bak
