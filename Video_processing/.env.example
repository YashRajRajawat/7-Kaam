# 7Kaam Video_processing — environment
#
# Copy to `.env` in THIS directory. The Node backend's .env is never read or
# modified by this module.
#
# In offline mode (the default) NONE of the secrets below are read. The module
# is designed to run, and its full test suite to pass, with a completely empty
# environment. This is the deliberate inverse of the backend convention, where
# services throw at import time when secrets are missing.

# ── Mode ──────────────────────────────────────────────────────────────────────
# offline = fixtures only, zero network. live = may contact Supabase/backend.
SEVENKAAM_MODE=offline

# ── Adapter selection ─────────────────────────────────────────────────────────
# mock      = deterministic, reads from the fixture bound to the submission
# heuristic = OpenCV rules over real media
# real      = NOT IMPLEMENTED (stubs raise with install instructions)
SEVENKAAM_ADAPTER_DETECTOR=mock
SEVENKAAM_ADAPTER_POSE=mock
SEVENKAAM_ADAPTER_OCR=mock

# ── Writeback safety ──────────────────────────────────────────────────────────
# never         = (DEFAULT) write VideoAssessment rows only. Never writes a
#                 ScoringLog VIDEO row, so a worker's videoScore, tier and
#                 KaamCard can never be moved by the AI. There is no delete
#                 route for ScoringLog anywhere in the platform, so every such
#                 row is permanent — hence the conservative default.
# verified_only = additionally promote provisionally/strongly_verified.
# all           = promote every outcome. Refused in live mode unless
#                 SEVENKAAM_I_UNDERSTAND_WRITEBACK_RISK=true.
SEVENKAAM_WRITEBACK_POLICY=never

# Master switch for ALL authenticated calls to the Node backend. While false,
# the module never mints a JWT and never calls score-video.
SEVENKAAM_ALLOW_NODE_WRITES=false
SEVENKAAM_I_UNDERSTAND_WRITEBACK_RISK=false

# ── Live mode only ────────────────────────────────────────────────────────────
# Same values as the backend's .env — reused, not duplicated.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Only read when SEVENKAAM_ALLOW_NODE_WRITES=true.
# NOTE: holding JWT_SECRET is equivalent to platform admin on every backend
# route. Tokens minted here are short-TTL and use the REVIEWER role, which is
# the least privilege that satisfies routes/scoring.js.
JWT_SECRET=
SEVENKAAM_SERVICE_ADMIN_ID=
SEVENKAAM_BACKEND_BASE_URL=http://localhost:8000/api/v1

SEVENKAAM_STORAGE_BUCKET=7kaam-assets
SEVENKAAM_MAX_VIDEO_BYTES=209715200

# ── Local ─────────────────────────────────────────────────────────────────────
SEVENKAAM_DB_PATH=sevenkaam.db
SEVENKAAM_API_BIND=127.0.0.1
