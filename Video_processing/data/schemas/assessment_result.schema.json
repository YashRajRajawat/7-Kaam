{
  "$defs": {
    "AssessmentReport": {
      "additionalProperties": false,
      "description": "Spec section 12.5.",
      "properties": {
        "strengths": {
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        },
        "improvements": {
          "items": {
            "type": "string"
          },
          "title": "Improvements",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "title": "AssessmentReport",
      "type": "object"
    },
    "ComponentScores": {
      "additionalProperties": false,
      "description": "All seven spec section 11.1 components.\n\nSpec section 17's example response shows only five (media, tools, task,\nsafety, knowledge) \u2014 a superset is emitted so section 17 consumers keep\nworking while the section 11.1 weights still sum to 1.0. Note the section 17\nspelling is `tools`, not `tool`.",
      "properties": {
        "identity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Identity",
          "type": "number"
        },
        "media": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Media",
          "type": "number"
        },
        "workspace": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Workspace",
          "type": "number"
        },
        "tools": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tools",
          "type": "number"
        },
        "task": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Task",
          "type": "number"
        },
        "safety": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Safety",
          "type": "number"
        },
        "knowledge": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Knowledge",
          "type": "number"
        }
      },
      "required": [
        "identity",
        "media",
        "workspace",
        "tools",
        "task",
        "safety",
        "knowledge"
      ],
      "title": "ComponentScores",
      "type": "object"
    },
    "Decision": {
      "description": "Spec section 11.4 confidence bands.\n\nOperational labels, deliberately not a raw number pretending to be truth.",
      "enum": [
        "insufficient_evidence",
        "needs_resubmission",
        "human_review",
        "provisionally_verified",
        "strongly_verified"
      ],
      "title": "Decision",
      "type": "string"
    },
    "MediaIdentity": {
      "additionalProperties": false,
      "description": "Hashes used for duplicate detection (spec section 13).",
      "properties": {
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "phash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phash"
        }
      },
      "title": "MediaIdentity",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Every code the engine can attach to a decision.",
      "enum": [
        "ALL_REQUIRED_TOOLS_VISIBLE",
        "TASK_STEPS_COMPLETED",
        "SAFETY_STEPS_OBSERVED",
        "MEDIA_QUALITY_GOOD",
        "IDENTITY_TOKEN_VERIFIED",
        "KNOWLEDGE_CHECK_STRONG",
        "MISSING_REQUIRED_TOOL",
        "TOKEN_MISMATCH",
        "TOKEN_UNREADABLE",
        "LOW_MEDIA_QUALITY",
        "VIDEO_TOO_SHORT",
        "NO_PERSON_DETECTED",
        "DUPLICATE_MEDIA",
        "SCENE_DISCONTINUITY",
        "METADATA_INCONSISTENT",
        "SAFETY_REVIEW_REQUIRED",
        "PRACTICAL_TASK_NOT_PASSED",
        "LOW_KNOWLEDGE_SCORE",
        "RESUBMIT_IDENTITY",
        "LOW_EVIDENCE_COVERAGE",
        "LIMIT_SINGLE_TASK",
        "LIMIT_NOT_A_LICENCE",
        "LIMIT_TOOLS_ARE_NOT_SKILL",
        "LIMIT_CONFIG_NOT_EXPERT_REVIEWED",
        "LIMIT_HEURISTIC_ADAPTERS",
        "LIMIT_UNCALIBRATED_SCORE",
        "TRADE_NOT_SUPPORTED_BY_DB",
        "NO_VIDEO_TRADETEST_FOR_TRADE",
        "AMBIGUOUS_VIDEO_TRADETEST",
        "SCHEMA_DRIFT_TABLE_MISSING",
        "WRITEBACK_POLICY_WITHHELD_SCORE"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "WritebackReceipt": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "written",
            "skipped",
            "skipped_offline",
            "degraded",
            "duplicate"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "video_assessment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Video Assessment Id"
        },
        "scoring_log_written": {
          "default": false,
          "title": "Scoring Log Written",
          "type": "boolean"
        },
        "score_sent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Sent"
        },
        "test_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Id"
        }
      },
      "required": [
        "status"
      ],
      "title": "WritebackReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The engine's output. Everything a reviewer needs, per spec section 14.",
  "properties": {
    "submission_id": {
      "title": "Submission Id",
      "type": "string"
    },
    "worker_id": {
      "title": "Worker Id",
      "type": "string"
    },
    "trade_id": {
      "title": "Trade Id",
      "type": "string"
    },
    "challenge_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Challenge Id"
    },
    "requested_test_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Test Id"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "score_100": {
      "title": "Score 100",
      "type": "number"
    },
    "evidence_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Evidence Coverage",
      "type": "number"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "components": {
      "$ref": "#/$defs/ComponentScores"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Missing Evidence",
      "type": "array"
    },
    "report": {
      "$ref": "#/$defs/AssessmentReport"
    },
    "versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Versions",
      "type": "object"
    },
    "adapter_modes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Adapter Modes",
      "type": "object"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "assessed_at": {
      "title": "Assessed At",
      "type": "string"
    },
    "media": {
      "$ref": "#/$defs/MediaIdentity"
    },
    "writeback": {
      "anyOf": [
        {
          "$ref": "#/$defs/WritebackReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "submission_id",
    "worker_id",
    "trade_id",
    "decision",
    "score",
    "score_100",
    "evidence_coverage",
    "reason_codes",
    "components",
    "report",
    "versions",
    "adapter_modes",
    "idempotency_key",
    "assessed_at"
  ],
  "title": "AssessmentResult",
  "type": "object"
}